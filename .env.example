# Brain Exercises Pro - Environment Variables Configuration Template
# Sao chép file này thành .env để sử dụng cho local hoặc điền vào Vercel / Cloud Provider

# Database connection (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@[YOUR_DB_HOST]:6543/postgres
DB_HOST=[YOUR_DB_HOST]
DB_PORT=6543
DB_USER=postgres.[YOUR_PROJECT_REF]
DB_PASSWORD=[YOUR_PASSWORD]
DB_NAME=postgres
DB_SSL=true

# Security & Application Settings (generate with: openssl rand -hex 32)
JWT_SECRET=[CHANGE_ME_STRONG_RANDOM_64_CHAR_HEX_SECRET]
PORT=3001
NODE_ENV=production

# Optional: Gemini API Key for Vocal Studio AI Audio Lyric Transcription & Word-Level Alignment
GEMINI_API_KEY=

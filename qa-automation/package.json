{
  "name": "qa-automation",
  "version": "1.0.0",
  "description": "Universal QA Operating System (ISTQB & Agentic Awesome Skills)",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --config=tests/playwright.config.ts --project=\"Desktop Chromium\"",
    "test:all-browsers": "playwright test --config=tests/playwright.config.ts",
